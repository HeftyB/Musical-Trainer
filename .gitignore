# Swift Package Manager
.build/
.swiftpm/
Package.resolved

# Xcode (this project builds with SPM; no checked-in project file)
*.xcodeproj
*.xcworkspace
xcuserdata/
DerivedData/

# Built app bundle — produced by ./build-app.sh, never committed
Musical Trainer.app/

# Release artifacts — produced by ./scripts/package-release.sh
dist/

# Working scratch. Holds current-git-commit-message.txt, the rolling message for whatever is
# currently uncommitted — see STANDARDS.md §8.2.1. Never committed: it describes the change
# being made, and once the change lands the commit itself is the record.
temp/

# Scratch work. Probes and one-off experiments are useful but disposable; keep them out of
# the repo so the source tree only ever contains code that ships or tests.
Scratch/
*.probe.swift

# macOS
.DS_Store

# Editors
.vscode/
.idea/

# Claude Code personal overrides — machine-specific, never committed
.claude/settings.local.json
