#!/bin/bash
# Validates the commit message against STANDARDS.md §8.2.
#
#   <type>(<scope>): <subject>
#
#   <body, wrapped at 72>
#
#   Refs: PLAN.md §<n>
#
# Written for bash 3.2, which is what macOS ships — no mapfile, no associative arrays.
set -uo pipefail

MSG_FILE="$1"
RED=$'\033[31m'; DIM=$'\033[2m'; OFF=$'\033[0m'
ERRORS=""
add_error() { ERRORS="${ERRORS}  • $1"$'\n'; }

# Strip comment lines; git puts its own guidance in there.
BODY_TEXT="$(grep -v '^#' "$MSG_FILE")"

SUBJECT="$(printf '%s\n' "$BODY_TEXT" | sed -n '1p')"
[ -z "$(printf '%s' "$BODY_TEXT" | tr -d '[:space:]')" ] && {
    printf '%sEmpty commit message.%s\n' "$RED" "$OFF"; exit 1; }

TYPES='feat|fix|perf|refactor|test|docs|build|chore'
SCOPES='timing-core|groove-core|trainer-kit|app|cli|docs|build'

# Merges and reverts are generated by git and exempt.
case "$SUBJECT" in
    Merge*|Revert*|fixup!*|squash!*) exit 0 ;;
esac

if ! printf '%s' "$SUBJECT" | grep -qE "^($TYPES)\(($SCOPES)\): .+"; then
    add_error "subject must be '<type>(<scope>): <subject>'"
    add_error "    types:  $TYPES"
    add_error "    scopes: $SCOPES"
fi

if [ ${#SUBJECT} -gt 72 ]; then
    add_error "subject is ${#SUBJECT} characters; the limit is 72"
fi

case "$SUBJECT" in
    *.) add_error "subject must not end with a period" ;;
esac

# Imperative mood: catch the endings that always mean the wrong mood.
DESCRIPTION="${SUBJECT#*: }"
FIRST_WORD="${DESCRIPTION%% *}"
case "$FIRST_WORD" in
    address|process|express|dismiss|pass|cross|discuss) ;;
    *ed|*ing|*s) add_error "subject should be imperative — 'add', not '$FIRST_WORD'" ;;
esac

SECOND_LINE="$(printf '%s\n' "$BODY_TEXT" | sed -n '2p')"
if [ -n "$SECOND_LINE" ]; then
    add_error "leave a blank line between the subject and the body"
fi

# Wrap the body at 72. Trailers, indented blocks and fences are exempt.
LINE_NO=0
while IFS= read -r line; do
    LINE_NO=$((LINE_NO + 1))
    [ "$LINE_NO" -le 1 ] && continue
    printf '%s' "$line" | grep -qE '^[A-Z][A-Za-z-]+: ' && continue
    printf '%s' "$line" | grep -qE '^(    |	|```)' && continue
    if [ ${#line} -gt 72 ]; then
        add_error "body line $LINE_NO is ${#line} characters; wrap at 72"
    fi
done <<EOF
$BODY_TEXT
EOF

# STANDARDS.md §0: the reasoning lives in PLAN.md and the commit points at it.
if printf '%s' "$SUBJECT" | grep -qE "^(feat|fix|perf|refactor)" \
   && ! printf '%s\n' "$BODY_TEXT" | grep -qE '^Refs: '; then
    add_error "add 'Refs: PLAN.md §<n>' — the reasoning lives there, not here"
fi

if [ -n "$ERRORS" ]; then
    printf '%sCommit message rejected.%s See STANDARDS.md §8.2.\n\n' "$RED" "$OFF"
    printf '%s  %s%s\n\n' "$DIM" "$SUBJECT" "$OFF"
    printf '%s\n' "$ERRORS"
    exit 1
fi
